{
  "name": "support-99tech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local support workflow plugin adapted from Anthropic's customer-support plugin",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
